---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}about/`, label: 'About Us' },
  { href: `${base}products/`, label: 'Products' },
  { href: `${base}contact/`, label: 'Contact Us' },
];
const productLinks = [
  { href: `${base}products/`, label: 'Hebel' },
  { href: `${base}products/`, label: 'Windows' },
  { href: `${base}products/`, label: 'Steel Frames' },
  { href: `${base}products/`, label: 'Tiles' },
  { href: `${base}products/`, label: 'Toilet Seats' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src={`${base}images/bulklogo.jpeg`} alt="Bulk Supplies Australia" width="200" height="67" class="footer-logo" loading="lazy" />
        <p>Building materials and construction supplies for a wide range of building requirements. Based in Kilkenny, South Australia.</p>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <ul role="list">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Products</h4>
        <ul role="list">
          {productLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul role="list">
          <li class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            23B Humphries Tce, Kilkenny SA 5009
          </li>
          <li class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:0434287537">0434 287 537</a>
          </li>
        </ul>
        <p class="footer-abn">ABN 37 640 283 003</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} Bulk Supplies Australia. All rights reserved. Designed by <a href="https://nubevest.com.au" target="_blank" rel="noopener noreferrer">Nubevest</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: rgba(255, 255, 255, 0.8);
    padding: 80px 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-logo {
    height: auto;
    width: 250px;
    margin-bottom: 16px;
    border-radius: 6px;
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 300px;
  }

  .footer-abn {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-lime);
    margin-top: 16px;
  }

  .footer-col h4 {
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    transition: color var(--transition);
  }

  .footer-col a:hover {
    color: var(--color-lime);
  }

  .footer-contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
  }

  .footer-contact-item svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .footer-bottom {
    padding: 24px 0;
    text-align: center;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9375rem;
    max-width: none;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 48px 0 0;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-brand p {
      max-width: none;
    }
    .footer-logo {
      width: 200px;
    }
  }
</style>
