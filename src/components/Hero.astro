---
interface Props {
  eyebrow?: string;
  heading: string;
  text: string;
  image: string;
  imageAlt: string;
  showButtons?: boolean;
  compact?: boolean;
}

const {
  eyebrow,
  heading,
  text,
  image,
  imageAlt,
  showButtons = false,
  compact = false,
} = Astro.props;
---
{compact ? (
  <section class="hero-compact">
    <img src={image} alt={imageAlt} class="hero-compact-bg" loading="eager" />
    <div class="hero-compact-overlay"></div>
    <div class="container hero-compact-content">
      <h1 class="animate-on-scroll">{heading}</h1>
      <p class="animate-on-scroll delay-1">{text}</p>
    </div>
  </section>
) : (
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-content-inner">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1>{heading}</h1>
          <p>{text}</p>
          {showButtons && (
            <div class="hero-buttons">
              <a href="/products/" class="btn btn-primary">Browse Products</a>
              <a href="tel:0434287537" class="btn btn-outline">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Call 0434 287 537
              </a>
            </div>
          )}
        </div>
      </div>
      <div class="hero-image">
        <img src={image} alt={imageAlt} loading="eager" width="960" height="700" />
      </div>
    </div>
  </section>
)}

<style>
  /* Full hero (home) */
  .hero {
    min-height: calc(100vh - var(--header-height));
    background-color: var(--color-primary);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - var(--header-height));
  }

  .hero-content {
    display: flex;
    align-items: center;
    padding: 60px 48px 60px 0;
    padding-left: max(24px, calc((100vw - var(--max-width)) / 2 + 24px));
  }

  .hero-content-inner {
    max-width: 560px;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    margin-bottom: 20px;
    line-height: 1.1;
  }

  .hero p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 480px;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-image {
    position: relative;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Compact hero (sub-pages) */
  .hero-compact {
    position: relative;
    padding: 100px 0 80px;
    min-height: 340px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-compact-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-compact-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(16, 45, 36, 0.92) 0%, rgba(23, 55, 43, 0.85) 100%);
  }

  .hero-compact-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-compact-content h1 {
    color: var(--color-white);
    margin-bottom: 16px;
  }

  .hero-compact-content p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.125rem;
    margin: 0 auto;
    max-width: 540px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-content {
      padding: 64px 24px;
      text-align: center;
    }

    .hero-content-inner {
      margin: 0 auto;
    }

    .hero p {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-image {
      height: 400px;
    }
  }

  @media (max-width: 600px) {
    .hero-content {
      padding: 48px 16px;
    }
    .hero-image {
      height: 280px;
    }
    .hero-compact {
      padding: 72px 0 56px;
      min-height: 260px;
    }
  }
</style>
