---
const features = [
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>',
    title: 'Quality Building Materials',
    description: 'We source products that meet the standards expected for Australian building and construction projects.',
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/></svg>',
    title: 'Reliable Supply',
    description: 'Consistent availability across our product range so your project stays on schedule.',
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17 12 2l10 15H2z"/><path d="m9.5 12.5 5 0"/><path d="m12 10 0 5"/></svg>',
    title: 'Competitive Pricing',
    description: 'Bulk supply pricing that helps you manage costs without compromising on quality.',
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    title: 'Personalised Support',
    description: 'Our team works with you to understand your project requirements and find the right products.',
  },
];
---
<section class="why-section section">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2>Why Choose Bulk Supplies Australia?</h2>
      <p>We provide building materials and construction supplies to help you get your project done right.</p>
    </div>
    <div class="features-grid">
      {features.map((feature, i) => (
        <div class={`feature-card animate-on-scroll delay-${i + 1}`}>
          <div class="feature-icon" set:html={feature.icon} />
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .feature-card {
    text-align: center;
    padding: 40px 24px;
    border-radius: var(--border-radius);
    background: var(--color-off-white);
    transition: all var(--transition);
  }

  .feature-card:hover {
    background: var(--color-white);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-4px);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--color-primary);
    color: var(--color-lime);
    margin-bottom: 20px;
  }

  .feature-card h3 {
    font-size: 1.0625rem;
    margin-bottom: 10px;
  }

  .feature-card p {
    font-size: 1rem;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .feature-card {
      padding: 32px 20px;
    }
  }
</style>
