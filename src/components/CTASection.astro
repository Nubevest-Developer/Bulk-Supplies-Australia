---
interface Props {
  heading?: string;
  text?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  heading = 'Planning your next project?',
  text = 'Get in touch with our team to discuss your building supply requirements.',
  buttonText = 'Request a Quote',
  buttonHref = `${import.meta.env.BASE_URL}contact/`,
} = Astro.props;
---
<section class="cta-section">
  <div class="container">
    <div class="cta-content animate-on-scroll">
      <h2>{heading}</h2>
      <p>{text}</p>
      <a href={buttonHref} class="btn btn-primary">{buttonText}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-white);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  .cta-content {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cta-content h2 {
    color: var(--color-dark);
    margin-bottom: 16px;
  }

  .cta-content p {
    color: var(--color-muted);
    font-size: 1.125rem;
    margin: 0 auto 32px;
  }

  .cta-content .btn-primary {
    background: var(--color-primary);
    color: var(--color-lime);
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 64px 0;
    }
  }
</style>
